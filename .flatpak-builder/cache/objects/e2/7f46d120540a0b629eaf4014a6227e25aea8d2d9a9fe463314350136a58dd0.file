{
  "id" : "io.github.LaceEditing.LacesFileConverter",
  "runtime" : "org.freedesktop.Platform",
  "runtime-version" : "24.08",
  "runtime-commit" : "05aa33f18efa68ba3e24757e8353fedd204e023ec567bbf3b6e29ea6283ee241",
  "sdk" : "org.freedesktop.Sdk",
  "sdk-commit" : "ffd4bb2ee750e633352a4a20e0b00f97004873f085d929f31511aeac89d0e0a7",
  "command" : "laces-file-converter",
  "modules" : [
    {
      "name" : "ffmpeg-extension",
      "buildsystem" : "simple",
      "build-commands" : [
        "mkdir -p ${FLATPAK_DEST}/lib/ffmpeg"
      ]
    },
    {
      "name" : "tcl",
      "subdir" : "unix",
      "buildsystem" : "autotools",
      "config-opts" : [
        "--enable-threads"
      ],
      "sources" : [
        {
          "url" : "https://prdownloads.sourceforge.net/tcl/tcl8.6.16-src.tar.gz",
          "sha256" : "91cb8fa61771c63c262efb553059b7c7ad6757afa5857af6265e4b0bdc2a14a5",
          "type" : "archive"
        }
      ],
      "post-install" : [
        "chmod 755 ${FLATPAK_DEST}/lib/libtcl*.so",
        "make install-private-headers"
      ]
    },
    {
      "name" : "tk",
      "subdir" : "unix",
      "buildsystem" : "autotools",
      "config-opts" : [
        "--enable-threads",
        "--with-tcl=/app/lib"
      ],
      "sources" : [
        {
          "url" : "https://prdownloads.sourceforge.net/tcl/tk8.6.16-src.tar.gz",
          "sha256" : "be9f94d3575d4b3099d84bc3c10de8994df2d7aa405208173c709cc404a7e5fe",
          "type" : "archive"
        }
      ],
      "post-install" : [
        "chmod 755 ${FLATPAK_DEST}/lib/libtk*.so",
        "make install-private-headers"
      ]
    },
    {
      "name" : "tkdnd",
      "buildsystem" : "autotools",
      "config-opts" : [
        "--with-tcl=/app/lib",
        "--with-tk=/app/lib"
      ],
      "sources" : [
        {
          "url" : "https://github.com/petasis/tkdnd/archive/refs/tags/tkdnd-release-test-v2.9.4.tar.gz",
          "sha256" : "cc6d3f0b7daca9564869e29e5db0996caa5f0c03d21c9b7032bad43f0a58121c",
          "type" : "archive"
        }
      ],
      "post-install" : [
        "mv ${FLATPAK_DEST}/lib/tkdnd* ${FLATPAK_DEST}/lib/tcl8.6/ || true"
      ]
    },
    {
      "name" : "python3-tkinter",
      "buildsystem" : "simple",
      "sources" : [
        {
          "url" : "https://www.python.org/ftp/python/3.12.12/Python-3.12.12.tar.xz",
          "sha256" : "fb85a13414b028c49ba18bbd523c2d055a30b56b18b92ce454ea2c51edc656c4",
          "type" : "archive"
        }
      ],
      "build-commands" : [
        "PYVER=$(python3 -c \"import sys; v=sys.version_info; print(f'{v.major}.{v.minor}')\")\nSUFFIX=$(python3 -c \"import sysconfig; print(sysconfig.get_config_var('EXT_SUFFIX'))\")\nexport CPPFLAGS=\"-I/app/include\"\nexport LDFLAGS=\"-L/app/lib\"\n./configure --prefix=/app \\\n  --enable-shared \\\n  --with-tcltk-includes=\"-I/app/include\" \\\n  --with-tcltk-libs=\"-L/app/lib -ltcl8.6 -ltk8.6\" \\\n  --without-ensurepip\nmake -j$(nproc) sharedmods\ninstall -Dm755 \"build/lib.linux-x86_64-${PYVER}/_tkinter${SUFFIX}\" \\\n  \"/app/lib/python${PYVER}/site-packages/_tkinter${SUFFIX}\"\n"
      ]
    },
    {
      "name" : "python3-customtkinter",
      "buildsystem" : "simple",
      "sources" : [
        {
          "url" : "https://files.pythonhosted.org/packages/f2/f2/728f041460f1b9739b85ee23b45fa5a505962ea11fd85bdbe2a02b021373/darkdetect-0.8.0-py3-none-any.whl",
          "sha256" : "a7509ccf517eaad92b31c214f593dbcf138ea8a43b2935406bbd565e15527a85",
          "type" : "file"
        },
        {
          "url" : "https://files.pythonhosted.org/packages/b7/b9/c538f279a4e237a006a2c98387d081e9eb060d203d8ed34467cc0f0b9b53/packaging-26.0-py3-none-any.whl",
          "sha256" : "b36f1fef9334a5588b4166f8bcd26a14e521f2b55e6b9de3aaa80d3ff7a37529",
          "type" : "file"
        },
        {
          "url" : "https://files.pythonhosted.org/packages/3b/b1/b43b33001a77256b335511e75f257d001082350b8506c8807f30c98db052/customtkinter-5.2.2-py3-none-any.whl",
          "sha256" : "14ad3e7cd3cb3b9eb642b9d4e8711ae80d3f79fb82545ad11258eeffb2e6b37c",
          "type" : "file"
        }
      ],
      "build-commands" : [
        "pip3 install --verbose --exists-action=i --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} customtkinter"
      ]
    },
    {
      "name" : "python3-tkinterdnd2",
      "buildsystem" : "simple",
      "sources" : [
        {
          "url" : "https://files.pythonhosted.org/packages/08/c3/e04f004a53c00dc01126b6f998264cef672c6883c36aa4bd65845a8eb4c0/tkinterdnd2-0.4.3-py3-none-any.whl",
          "sha256" : "8804f5d2e2a99713ec93e85384397fec6bf66fdf2065e3750938d55018971c4a",
          "type" : "file"
        }
      ],
      "build-commands" : [
        "pip3 install --verbose --exists-action=i --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} tkinterdnd2"
      ]
    },
    {
      "name" : "python3-pygame-ce",
      "buildsystem" : "simple",
      "sources" : [
        {
          "url" : "https://files.pythonhosted.org/packages/db/17/70ada4cef84eca48a995cc9e0f2f087e6190b3e4111e9c8ec3c7a8f689bd/pygame_ce-2.5.7-cp312-cp312-manylinux2014_x86_64.manylinux_2_17_x86_64.whl",
          "sha256" : "0d8fa8822c0f4b5ae6b44ada7be9f2193fd512da1381c37fa3c5bda8971d64cb",
          "type" : "file"
        }
      ],
      "build-commands" : [
        "pip3 install --verbose --exists-action=i --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} pygame-ce"
      ]
    },
    {
      "name" : "laces-file-converter",
      "buildsystem" : "simple",
      "sources" : [
        {
          "path" : ".",
          "type" : "dir"
        }
      ],
      "build-commands" : [
        "install -Dm755 main.py ${FLATPAK_DEST}/share/laces-file-converter/main.py",
        "cp -r assets ${FLATPAK_DEST}/share/laces-file-converter/assets",
        "install -Dm755 laces-file-converter.sh ${FLATPAK_DEST}/bin/laces-file-converter",
        "install -Dm644 io.github.LaceEditing.LacesFileConverter.desktop ${FLATPAK_DEST}/share/applications/io.github.LaceEditing.LacesFileConverter.desktop",
        "install -Dm644 io.github.LaceEditing.LacesFileConverter.metainfo.xml ${FLATPAK_DEST}/share/metainfo/io.github.LaceEditing.LacesFileConverter.metainfo.xml",
        "install -Dm644 assets/icons/icon2.png ${FLATPAK_DEST}/share/icons/hicolor/32x32/apps/io.github.LaceEditing.LacesFileConverter.png",
        "install -Dm644 assets/icons/icon2_64.png ${FLATPAK_DEST}/share/icons/hicolor/64x64/apps/io.github.LaceEditing.LacesFileConverter.png",
        "install -Dm644 assets/icons/icon2_128.png ${FLATPAK_DEST}/share/icons/hicolor/128x128/apps/io.github.LaceEditing.LacesFileConverter.png"
      ]
    }
  ],
  "cleanup" : [
    "/include",
    "/lib/pkgconfig",
    "/share/man"
  ],
  "finish-args" : [
    "--share=ipc",
    "--socket=x11",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--filesystem=home",
    "--device=dri"
  ],
  "add-extensions" : {
    "org.freedesktop.Platform.ffmpeg-full" : {
      "directory" : "lib/ffmpeg",
      "add-ld-path" : ".",
      "version" : "24.08"
    }
  },
  "source-date-epoch" : 1773973170
}